{
  "name": "velvet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-if-configured.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:responsibility": "node scripts/check-responsibility-boundary.mjs",
    "check:message-draft": "node scripts/check-message-draft-contract.mjs",
    "check:recall": "node scripts/check-recall-policy.mjs",
    "check:memory-inputs": "node scripts/check-memory-input-paths.mjs",
    "check:repeat-visits": "node scripts/check-repeat-visit-flow.mjs",
    "check:conversation-episodes": "node scripts/check-conversation-episodes.mjs",
    "check:mobile-ux": "node scripts/check-mobile-ux.mjs",
    "check:feedback-hub": "node scripts/check-feedback-hub-boundary.mjs",
    "check:plan-enforcement": "node scripts/check-plan-enforcement.mjs",
    "check:media-access": "node scripts/check-media-access.mjs",
    "check:auth-boundary": "node scripts/check-auth-boundary.mjs",
    "check:soon-alerts": "node scripts/check-soon-alerts.mjs",
    "check:next-action-due-dates": "node scripts/check-next-action-due-dates.mjs",
    "check:customer-sorting": "node scripts/check-customer-sorting.mjs",
    "check:search-boundary": "node scripts/check-search-boundary.mjs",
    "check:query-efficiency": "node scripts/check-query-efficiency.mjs",
    "check:input-limits": "node scripts/check-input-limits.mjs",
    "check:capture-idempotency": "node scripts/check-capture-idempotency.mjs",
    "check:privacy-cache": "node scripts/check-privacy-cache.mjs",
    "check:doc-consistency": "node scripts/check-doc-consistency.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": { "@clerk/nextjs": "^7.9.2", "next": "^16.0.0", "pg": "^8.13.1", "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "@opennextjs/cloudflare": "^1.20.2", "@types/node": "^22.0.0", "@types/pg": "^8.11.10", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "typescript": "^5.9.0", "wrangler": "^4.126.0" }
}
