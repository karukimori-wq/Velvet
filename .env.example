# Velvet runtime
NODE_ENV=development

# Authentication seam
# Development may omit this and use user_demo_owner.
# Production must supply a real authenticated owner through the auth integration.
VELVET_OWNER_USER_ID=

# Storage
# memory | postgres
VELVET_STORAGE_MODE=memory
DATABASE_URL=

# AI Platform Core
AI_PLATFORM_CORE_URL=
# Existing AI Platform Core HTTP transport. Defaults shown below.
AI_PLATFORM_CORE_GATEWAY_PATH=/v1/gateway/run
AI_PLATFORM_CORE_USAGE_PATH=/v1/analytics/usage
# Client Manifest id registered in AI Platform Core with permissions:
# velvet.capture.structure, velvet.search.parse_intent
AI_PLATFORM_CORE_CLIENT_ID=velvet

# Other platform integrations
SNS_PLANNER_BASE_URL=
PLATFORM_ADMIN_BASE_URL=
GROWTH_ENGINE_BASE_URL=
