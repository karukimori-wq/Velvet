# Velvet runtime
NODE_ENV=development

# Authentication seam
# Development may omit this and use user_demo_owner.
# Production must supply a real authenticated owner through the auth integration.
VELVET_OWNER_USER_ID=

# Storage
# memory | postgres
VELVET_STORAGE_MODE=memory
DATABASE_URL=

# External platform integrations
AI_PLATFORM_CORE_URL=
# Exact synchronous transport paths are deployment-specific.
# Shared operation names are VelvetCapture.Structure and VelvetSearch.ParseIntent.
AI_PLATFORM_CORE_CAPTURE_PATH=
AI_PLATFORM_CORE_SEARCH_PATH=
# Exact Usage.List endpoint URL. AI Platform Core remains source of truth.
AI_PLATFORM_CORE_USAGE_URL=
SNS_PLANNER_BASE_URL=
PLATFORM_ADMIN_BASE_URL=
GROWTH_ENGINE_BASE_URL=
