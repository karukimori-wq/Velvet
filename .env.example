# Velvet runtime
NODE_ENV=development

# Authentication
# demo | fixed_owner | session
# demo/fixed_owner are development or private single-user modes only.
# Public production requires session mode.
VELVET_AUTH_MODE=demo
VELVET_OWNER_USER_ID=
# Server-only secret shared with the trusted upstream auth/session bridge.
# Never expose through NEXT_PUBLIC_* or browser code.
VELVET_SESSION_BRIDGE_SECRET=

# Plan entitlement seam
# free | pro is used only in memory/development mode.
# PostgreSQL mode resolves plan per owner from velvet_owner_entitlements.
VELVET_PLAN=free

# Storage
# memory | postgres | d1
# Cloudflare Production uses d1.
VELVET_STORAGE_MODE=memory
DATABASE_URL=
VELVET_DB_POOL_MAX=5
# Leave unset for TLS-enabled databases. Set to disable only for trusted local DBs.
VELVET_DB_SSL=

# Image storage
# Keep empty until a real storage adapter/provider is selected.
# Free is blocked regardless of this value; Pro also requires a configured adapter.
VELVET_IMAGE_STORAGE_PROVIDER=

# AI Platform Core
AI_PLATFORM_CORE_URL=
AI_PLATFORM_CORE_GATEWAY_PATH=/v1/gateway/run
AI_PLATFORM_CORE_USAGE_PATH=/v1/analytics/usage
AI_PLATFORM_CORE_CLIENT_ID=velvet

# Feedback Hub
# Leave empty until the shared Feedback Hub API is connected.
FEEDBACK_HUB_BASE_URL=
# Optional server-only integration secret. Never expose through NEXT_PUBLIC_*.
FEEDBACK_HUB_INTEGRATION_SECRET=

# Other platform integrations
SNS_PLANNER_BASE_URL=
PLATFORM_ADMIN_BASE_URL=
# Canonical Growth Engine Production endpoint (Cloudflare Workers).
GROWTH_ENGINE_BASE_URL=https://growth-engine.karukimori.workers.dev
# Same server-only value as Growth Engine VELVET_INTEGRATION_SECRET.
# Never expose through NEXT_PUBLIC_* or browser code.
GROWTH_ENGINE_INTEGRATION_SECRET=
